# --- LLM (chat generation) ---
# Local / own model (default, no key needed):
LLM_PROVIDER="ollama"
LLM_MODEL="llama3"
# BYOK example (uncomment to use a hosted provider by default):
# LLM_PROVIDER="openai"
# LLM_MODEL="gpt-4o-mini"
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"
LLM_TEMPERATURE="0.2"
OLLAMA_BASE_URL="http://localhost:11434"

# --- Embeddings (can differ from chat provider) ---
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="mxbai-embed-large:335m"
# EMBEDDING_API_KEY="sk-..."
# EMBEDDING_BASE_URL="https://api.openai.com/v1"

# --- Retrieval / accuracy tuning ---
RERANKER_MODEL="BAAI/bge-reranker-base"
ENABLE_RERANKER="true"
ENABLE_HYBRID_SEARCH="true"
RETRIEVAL_K="20"
RERANK_TOP_N="5"
HYBRID_VECTOR_WEIGHT="0.5"
CHUNK_SIZE="900"
CHUNK_OVERLAP="150"
MAX_CONTEXT_CHARS="12000"

# --- Application paths ---
FAISS_PATH="vector_store.faiss"
UPLOAD_DIRECTORY="uploaded_files"
CHAT_DB_PATH="chat_history.db"
PROVIDER_CONFIG_PATH="provider_config.json"

# --- Upload limits ---
MAX_FILE_MB="25"
ALLOWED_EXTENSIONS=".pdf,.txt,.md,.csv,.docx,.png,.jpg,.jpeg"

# --- Serving / errors ---
SERVE_FILES="true"
DEBUG_ERRORS="false"

# --- Retention + rate limits ---
MAX_MESSAGES_PER_SESSION="500"
RATE_LIMIT_CHAT_PER_MIN="30"
RATE_LIMIT_UPLOAD_PER_MIN="10"
RATE_LIMIT_TEST_PER_MIN="10"

# --- Analysis roles (configurable) ---
ANALYSIS_ROLES="Finance Manager,Customer Manager,Safety Manager,HR Coordinator,Legal Counsel,Rolling Stock Engineer"

# --- CORS (comma-separated; "*" = dev only, no credentials) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --- n8n Integration (JSON list) ---
N8N_WEBHOOK_URLS_JSON='[]'
